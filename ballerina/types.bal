    @http:Header {name: "Content-Language"}
    string contentLanguage;
    # This header indicates the format of the request body provided by the client. Its value should be set to application/json
    @http:Header {name: "Content-Type"}
    string contentType;
};

# This type lists regional product compliance policies to be used by an offer when it is published and converted to a listing
public type RegionalProductCompliancePolicies record {
    # The array of country-specific product compliance policies to be used by an offer when it is published and converted to a listing
    CountryPolicy[] countryPolicies?;
};

# This type is used by the createOrReplaceProductCompatibility call to associate compatible vehicles to an inventory item. This type is also the base response of the getProductCompatibility call
public type Compatibility record {
    # This container consists of an array of motor vehicles (make, model, year, trim, engine) that are compatible with the motor vehicle part or accessory specified by the sku value
    CompatibleProduct[] compatibleProducts;
    # The seller-defined SKU of the inventory item associated with the compatible vehicles. Always returned by getProductCompatibility.
    string sku;
};

# Charitable organization associated with the listing and the percentage of sale proceeds it receives. The organization must be registered with the PayPal Giving Fund to receive proceeds.
public type Charity record {
    # The percentage of the purchase price donated to the charity, from 10 to 100 in increments of 5. Required when donating to a charity.
    string donationPercentage?;
    # The eBay-assigned unique identifier of the charitable organization that receives a percentage of sales proceeds. Required when donating to a charity.
    string charityId?;
};

# This type is used to define the pictograms and statement containers, and the optional component field, that provide product safety and compliance related information
public type ProductSafety record {
    # Product safety component information, such as a specific warning. Requires pictograms and/or statements. Maximum length: 120 characters.
    string component?;
    # The identifiers of product safety pictograms to display on the listing. Maximum of 2.
    string[] pictograms?;
    # The identifiers of product safety statements to display on the listing. Maximum of 8.
    string[] statements?;
};

# Unit of measure for the dimensions of a shipping package.
public type LengthUnitOfMeasureEnum "INCH"|"FEET"|"CENTIMETER"|"METER";

# This type is used to indicate the parameter field/value that caused an issue with the call request
public type ErrorParameterV3 record {
    # This type contains the name and value of an input parameter that contributed to a specific error or warning condition
    string name?;
    # This is the actual value that was passed in for the element specified in the name field
    string value?;
};

# Energy efficiency information for certain durable goods. The energy efficiency rating and range must be specified through the inventory item's aspects field.
public type EnergyEfficiencyLabel record {
    # The URL to the Product Information Sheet that provides complete manufacturer-provided efficiency information about an item
    string productInformationSheet?;
    # A brief verbal summary of the information included on the Energy Efficiency Label for an item.
    # 
    # For example, On a scale of A to G the rating is E.
    string imageDescription?;
    # The URL to the Energy Efficiency Label image that is applicable to an item
    string imageURL?;
};

# This type is used by the seller to provide additional information about the condition of an item in a structured format
public type ConditionDescriptor record {
    # The numeric IDs of the values for the condition descriptor, such as a grader, grade or card condition.
    string[] values?;
    # Open-text additional information for a condition descriptor, such as a certification number or damage code for graded items. Maximum length: 30.
    string additionalInfo?;
    # The numeric ID of the condition descriptor name. Condition descriptor name-value pairs describe an item's condition in a structured way.
    string name?;
};

# Result for each offer or inventory item updated with bulkUpdatePriceQuantity, including any errors or warnings at that level.
public type PriceQuantityResponse record {
    # This array will be returned if there were one or more warnings associated with the update to the offer or inventory item record
    ErrorDetailV3[] warnings?;
    # The unique identifier of the offer that was updated. This field will not be returned in situations where the seller is only updating the total 'ship-to-home' quantity of an inventory item record
    string offerId?;
    # The seller-defined SKU of the product. Always returned. Maximum length: 50.
    string sku;
    # This array will be returned if there were one or more errors associated with the update to the offer or inventory item record
    ErrorDetailV3[] errors?;
    # The HTTP status code of the price and/or quantity update attempt; 200 indicates success.
    int:Signed32 statusCode;
};

# Controls how and when the Minimum Advertised Price is shown for an offer. Available only on the US site.
public type MinimumAdvertisedPriceHandlingEnum "NONE"|"PRE_CHECKOUT"|"DURING_CHECKOUT";

# This type is used by the base response of the getInventoryLocation and getInventoryLocations calls. These responses provide details about inventory location(s) defined for the merchant's account
public type InventoryLocationResponse record {
    # The time zone of the inventory location in Olson format (for example America/Vancouver).
    string timeZoneId?;
    # This text field shows the  Website address (URL) associated with the inventory location. This field is returned if defined for the location
    string locationWebUrl?;
    # This array indicates if the inventory location is a warehouse or a fulfillment center
    StoreTypeEnum[] locationTypes;
    # The unique identifier of the inventory location. This identifier is set up by the merchant when the location is first created with the createInventoryLocation call
    string merchantLocationKey;
    # The name of the inventory location. This name should be a human-friendly name
    string name?;
    # Possible states of an inventory location.
    StatusEnum merchantLocationStatus;
    # A complex type that is used to provide the physical address of a location, and it geo-coordinates
    Location location;
    # This type is used to provide shipping specification details, such as the weekly cut-off schedule for order handling and cut-off override(s), for a fulfillment center location. 
    FulfillmentCenterSpecifications fulfillmentCenterSpecifications?;
    # This text field provides additional information about an inventory location. This field is returned if it is set for the location
    string locationAdditionalInformation?;
};

# Updates the total ship-to-home quantity of inventory items and/or the price and quantity of specific offers associated with them.
public type PriceQuantity record {
    # The published offers whose price and/or quantity to update, one entry per offer. Not for unpublished offers.
    OfferPriceQuantity[] offers?;
    # This type is used to specify the total 'ship-to-home' quantity of the inventory item that will be available for purchase through one or more published offers
    ShipToLocationAvailability shipToLocationAvailability?;
    # The seller-defined SKU of the inventory item whose total ship-to-home quantity is updated. Required only when using shipToLocationAvailability. Maximum length: 50.
    string sku;
};

# Base response of the createOrReplaceInventoryItem, createOrReplaceInventoryItemGroup and createOrReplaceProductCompatibility calls, returned only when errors or warnings occur.
public type BaseResponse record {
    # The errors or warnings triggered by the call, returned only if any occur.
    ErrorDetailV3[] warnings?;
};

# Hazardous material information for the listing. The statements field is required; pictograms, signalWord and component are optional.
public type Hazmat record {
    # This field is used by the seller to provide component information for the listing. For example, component information can provide the specific material of Hazmat concern.
    # 
    # Maximum length: 120
    string component?;
    # The hazard pictogram codes stated on the product's Safety Data Sheet, displayed on the listing.
    string[] pictograms?;
    # The hazardous materials signal word stated on the product's Safety Data Sheet, displayed on the listing.
    string signalWord?;
    # The hazard statement codes stated on the product's Safety Data Sheet. Required if hazardous material information is provided.
    string[] statements?;
};

# This type is used to specify the quantity of the inventory items that are available for purchase if the items will be shipped to the buyer
public type AvailabilityWithAll record {
    # This type is used to specify the total 'ship-to-home' quantity of the inventory items that will be available for purchase through one or more published offers
    ShipToLocationAvailabilityWithAll shipToLocationAvailability?;
};

# Locale that indicates the language used to express the inventory item details.
public type LocaleEnum "en_US"|"en_CA"|"fr_CA"|"en_GB"|"en_AU"|"en_IN"|"de_AT"|"fr_BE"|"fr_FR"|"de_DE"|"it_IT"|"nl_BE"|"nl_NL"|"es_ES"|"de_CH"|"fi_FI"|"zh_HK"|"hu_HU"|"en_PH"|"pl_PL"|"pt_PT"|"ru_RU"|"en_SG"|"en_IE"|"en_MY";

# Unpublished offer for which getListingFees retrieves expected listing fees. Up to 250 offerId values can be passed.
public type OfferKeyWithId record {
    # The ID of an unpublished offer to retrieve expected listing fees for. Up to 250 per request; published offers cause errors.
    string offerId;
};

# Package type, weight and dimensions of the shipping package. Weight and dimensions are required for calculated shipping; weight alone is required for flat-rate shipping with a weight surcharge.
public type PackageWeightAndSize record {
    # Whether the package is irregular and needs special or fragile handling. Applies to calculated shipping only.
    boolean shippingIrregular?;
    # Weight of a shipping package and its unit of measure. Conditionally required for calculated shipping rates or flat-rate shipping with a weight surcharge.
    Weight weight?;
    # Type of shipping package used to ship an inventory item.
    PackageTypeEnum packageType?;
    # Dimensions of a shipping package and their unit of measure. Conditionally required when the seller offers calculated shipping rates.
    Dimension dimensions?;
};

# This type is used by the base response payload of the publishOffer and publishOfferByInventoryItemGroup calls
public type PublishResponse record {
    # This container will contain an array of errors and/or warnings if any occur when a publishOffer or publishOfferByInventoryItemGroup call is made
    ErrorDetailV3[] warnings?;
    # The unique identifier of the newly created eBay listing. Returned if the offer or group of offers was successfully published.
    string listingId?;
};

# Overrides the shipping cost for one item, each additional item, or the surcharge of a domestic or international shipping service option in the fulfillment policy applied to the offer.
public type ShippingCostOverride record {
    # This type is used to express a dollar value and the applicable currency
    Amount surcharge?;
    # Whether the shipping service option whose costs are overridden is domestic or international.
    ShippingServiceTypeEnum shippingServiceType?;
    # This type is used to express a dollar value and the applicable currency
    Amount shippingCost?;
    # This type is used to express a dollar value and the applicable currency
    Amount additionalShippingCost?;
    # The sort order of the shipping service option in the fulfillment policy whose costs are overridden. Required for each override and always returned.
    int:Signed32 priority?;
};

# This type is used to provide shipping specification details, such as the weekly cut-off schedule for order handling and cut-off override(s), for a fulfillment center location. 
public type FulfillmentCenterSpecifications record {
    # This type is used by the createInventoryLocation call to specify cut-off time(s) for an inventory location, as well as any overrides for these times
    SameDayShippingCutOffTimes sameDayShippingCutOffTimes?;
};

# This type is used to express a dollar value and the applicable currency
public type Amount record {
    # The three-letter ISO 4217 currency code. Both value and currency are required and always returned when expressing prices.
    string currency?;
    # A string representation of a dollar value expressed in the currency specified in the currency field. Both the value and currency fields are required/always returned when expressing prices
    string value?;
};

# Expected listing fees per eBay marketplace for one or more unpublished offers, including any promotional discounts applied to a fee.
public type Fee record {
    # This type is used to express a dollar value and the applicable currency
    Amount amount;
    # This type is used to express a dollar value and the applicable currency
    Amount promotionalDiscount?;
    # The type of listing fee the seller may incur if the offers are published, such as InsertionFee or SubtitleFee. Fees may be returned even when 0.0.
    string feeType;
};

# Inventory location types. STORE is deprecated and no longer supported.
public type StoreTypeEnum "STORE"|"WAREHOUSE"|"FULFILLMENT_CENTER";

# Product aspect on which variations within an inventory item group vary, such as size or color, and the order its values appear in the listing.
public type Specification record {
    # The values of the product variation aspect named in the name field. At least one value is required. Maximum length: 50.
    string[] values?;
    # The name of the product variation aspect, such as Size or Color. Required before an offer can be published. Maximum length: 40.
    string name?;
};

# Dimensions of a shipping package and their unit of measure. Conditionally required when the seller offers calculated shipping rates.
public type Dimension record {
    # Unit of measure for the dimensions of a shipping package.
    LengthUnitOfMeasureEnum unit?;
    # The length of the shipping package, in the unit given in the unit field. All dimension fields are required if package dimensions are specified.
    decimal length?;
    # The width of the shipping package, in the unit given in the unit field. All dimension fields are required if package dimensions are specified.
    decimal width?;
    # The height of the shipping package, in the unit given in the unit field. All dimension fields are required if package dimensions are specified.
    decimal height?;
};

# Status of the eBay listing associated with an offer.
public type ListingStatusEnum "ACTIVE"|"OUT_OF_STOCK"|"INACTIVE"|"ENDED"|"EBAY_ENDED"|"NOT_LISTED";

# This type provides details of an offer, and is used by the response payloads of the getOffer and the getOffers calls
public type EbayOfferDetailsWithAll record {
    # The quantity of the inventory item available for purchase on the marketplace given in marketplaceId.
    int:Signed32 availableQuantity?;
    # Whether the private listing feature is enabled, hiding buyer IDs from other users. Always returned; defaults to false.
    boolean hideBuyerDetails;
    # Whether eBay product catalog details are applied to the listing, based on the product identifier. Defaults to true.
    boolean includeCatalogProductDetails;
    # The number of identical items sold in a lot listing. Returned only for lot listings.
    int:Signed32 lotSize?;
    # The maximum quantity of the inventory item that each buyer may purchase, across one or more transactions. Set only if the seller restricts purchase quantity.
    int:Signed32 quantityLimitPerBuyer?;
    # Type defining regulatory information that the seller is required to disclose
    Regulatory regulatory?;
    # Listing format of the offer. Creating an auction offer reserves one unit of the item's available quantity until the auction ends.
    FormatTypeEnum format;
    # The unique identifier of a secondary category, used when listing the item in two categories. A fee may apply.
    string secondaryCategoryId?;
    # Enables a sales-tax table, sets a tax exception category code, or specifies a VAT percentage. Sales-tax tables are available only for the US and Canada marketplaces.
    Tax tax?;
    # Listing price and Minimum Advertised Price and Strikethrough Pricing settings. Price is required before an offer is published, but can be omitted when the offer is created.
    PricingSummary pricingSummary;
    # Business policies (payment, return and fulfillment) and custom policies for the listing. Every published offer needs payment, return and fulfillment policies; also holds shipping cost overrides, eBay Plus and Best Offer settings.
    ListingPolicies listingPolicies;
    # eBay marketplace sites.
    MarketplaceEnum marketplaceId;
    # Charitable organization associated with the listing and the percentage of sale proceeds it receives. The organization must be registered with the PayPal Giving Fund to receive proceeds.
    Charity charity?;
    # The unique identifier of the inventory location; it cannot be modified once set. Always returned for published offers, and only if set for unpublished offers. Maximum length: 36.
    string merchantLocationKey?;
    # The unique identifier of the offer. This identifier is used in many offer-related calls, and it is also used in the bulkUpdatePriceQuantity call
    string offerId;
    # The full paths of up to two eBay store categories the item is placed in, such as /Fashion/Men/Shirts. Returned if set.
    string[] storeCategoryNames?;
    # The UTC date and time the seller set for a scheduled listing to become active, for example 2023-05-30T19:08:00Z. Returned if set.
    string listingStartDate?;
    # IDs of the producer or importer related to the new item, packaging, added documentation or an eco-participation fee.
    ExtendedProducerResponsibility extendedProducerResponsibility?;
    # eBay listing ID, listing status and quantity sold for an offer. Returned only for published offers.
    ListingDetails listing?;
    # This is the seller-defined SKU value of the product in the offer.
    # 
    # Maximum length: 50
    string sku;
    # The unique identifier of the primary eBay category that the inventory item is listed under. This field is always returned for published offers, but is only returned if set for unpublished offers
    string categoryId?;
    # Listing duration periods. GTC applies to fixed-price listings and is their only supported duration; the DAYS_n values apply to auction listings.
    ListingDurationEnum listingDuration;
    # The listing description of the offer. Always returned for published offers, and only if set for unpublished offers. Maximum length: 500,000, including HTML markup.
    string listingDescription?;
    # Current status of the offer, published or unpublished.
    OfferStatusEnum status;
};

# This type is used to display the results of each listing that the seller attempted to migrate
public type MigrateListingResponse record {
    # eBay marketplace sites.
    MarketplaceEnum marketplaceId;
    # The SKU values and offer IDs of the migrated listing: one pair for a single-variation listing, several for a multiple-variation listing.
    InventoryItemListing[] inventoryItems;
    # Details of any warnings raised while migrating the listing. A listing can still migrate successfully with warnings.
    ErrorDetailV3[] warnings?;
    # The eBay-generated key of the inventory item group created for a migrated multiple-variation listing. Returned only for multiple-variation listings.
    string inventoryItemGroupKey?;
    # The unique identifier of the eBay listing that the seller attempted to migrate
    string listingId;
    # If one or more errors occur with the attempt to migrate the listing, this container will be returned with detailed information on each error
    ErrorDetailV3[] errors?;
    # This field is returned for each listing that the seller attempted to migrate. See the HTTP status codes table to see which each status code indicates
    int:Signed32 statusCode;
};

# Request payload of publishByInventoryItemGroup, giving the inventory item group to publish and the eBay marketplace to publish it on.
public type PublishByInventoryItemGroupRequest record {
    # eBay marketplace sites.
    MarketplaceEnum marketplaceId;
    # The eBay-generated key of the inventory item group whose unpublished offers are published as a multiple-variation listing.
    string inventoryItemGroupKey;
};

# This type is used by the base request payload of the createOrReplaceInventoryItemGroup call and the base response payload of the getInventoryItemGroup call
public type InventoryItemGroup record {
    # This type is used to specify the product aspect(s) where individual items of the group vary, as well as a list of the available variations of those aspects
    VariesBy variesBy?;
    # The SKUs of the inventory items in the group. Required and always returned; omit a SKU to remove it, unless that variation has sales.
    string[] variantSKUs;
    # HTTPS links to images for the group. At least one image is required before publishing, and images must be given here if aspectsImageVariesBy is used.
    string[] imageUrls?;
    # An optional listing subtitle for the group, which incurs an extra fee and overrides item subtitles. Returned if set. Maximum length: 55.
    string subtitle?;
    # The item specifics name-value pairs shared by all variations in the group, such as pattern. Required before the group's first offer is published.
    record {|string[]...;|} aspects?;
    # The seller-created unique identifier of the inventory item group. Returned by getInventoryItemGroup.
    string inventoryItemGroupKey;
    # The group's description, which becomes the listing description; HTML is allowed. Required before the first offer is published. Maximum length: 500,000, including HTML markup.
    string description?;
    # The group's title, which becomes the listing title. Required before the first offer of the group is published. Maximum length: 80.
    string title?;
    # The eBay video IDs for the group, created when a video is uploaded. Only one video per listing is supported.
    string[] videoIds?;
};

# Publish status of an offer. Returns the eBay listing ID on success, or errors and/or warnings explaining why publishing failed.
public type OfferResponseWithListingId record {
    # This container will be returned if there were one or more warnings associated with publishing the offer
    ErrorDetailV3[] warnings?;
    # The unique identifier of the offer that the seller published (or attempted to publish)
    string offerId;
    # The unique identifier of the newly-created eBay listing. This field is only returned if the seller successfully published the offer and created the new eBay listing
    string listingId?;
    # This container will be returned if there were one or more errors associated with publishing the offer
    ErrorDetailV3[] errors?;
    # The HTTP status code indicating whether publishing the offer succeeded or failed.
    int:Signed32 statusCode;
};

# Days of the week, used by the weeklySchedule container to specify fulfillment center cut-off times.
public type DayOfWeekEnum "MONDAY"|"TUESDAY"|"WEDNESDAY"|"THURSDAY"|"FRIDAY"|"SATURDAY"|"SUNDAY";

# Represents the Headers record for the operation: bulkMigrateListing
public type BulkMigrateListingHeaders record {
    # This header indicates the format of the request body provided by the client. Its value should be set to application/json
    @http:Header {name: "Content-Type"}
    string contentType;
};

# This type is used by the base request of the bulkGetInventoryItem method
public type BulkGetInventoryItem record {
    # The seller passes in multiple SKU values under this container to retrieve multiple inventory item records. Up to 25 inventory item records can be retrieved at one time
    GetInventoryItem[] requests;
};

# This type provides the unique identifier of an inventory location that is associated with a SKU within a listing
public type LocationAvailabilityDetails record {
    # The seller-defined key of the fulfillment center location where inventory is available. For location mappings, it must be a FULFILLMENT_CENTER location.
    string merchantLocationKey;
};

# Represents the Queries record for the operation: getOffers
public type GetOffersQueries record {
    # eBay marketplace ID to restrict the returned offers to one marketplace.
    @http:Query {name: "marketplace_id"}
    string marketplaceId?;
    # Page number to retrieve, as an integer of 0 or greater, starting at 0 for the first page. Default: 0.
    string offset?;
    # Listing format of the offers to retrieve, such as FIXED_PRICE.
    string format?;
    # Maximum number of records to return per page, as a positive integer. Up to 100 records are returned if not set.
    string 'limit?;
    # Seller-defined SKU whose offers are returned. Maximum length: 50.
    string sku;
};

# This type is used by the base request of the bulkPublishOffer method, which is used to publish up to 25 different offers
public type BulkOffer record {
    # This container is used to pass in an array of offers to publish. Up to 25 offers can be published with one bulkPublishOffer method
    OfferKeyWithId[] requests;
};

# Represents the Headers record for the operation: updateInventoryLocation
public type UpdateInventoryLocationHeaders record {
    # This header indicates the format of the request body provided by the client. Its value should be set to application/json
    @http:Header {name: "Content-Type"}
    string contentType;
};

# This type is used to specify the product aspect(s) where individual items of the group vary, as well as a list of the available variations of those aspects
public type VariesBy record {
    # The product aspect, such as Color, whose variations are shown with different images. Only the first aspect is used. Required before an offer can be published.
    string[] aspectsImageVariesBy?;
    # The product aspects that vary across the group and their values. Required before the first offer of the group is published; returned if set or once published.
    Specification[] specifications?;
};

# Type defining regulatory information that the seller is required to disclose
public type Regulatory record {
    # Energy efficiency information for certain durable goods. The energy efficiency rating and range must be specified through the inventory item's aspects field.
    EnergyEfficiencyLabel energyEfficiencyLabel?;
    # Regulatory documents associated with the listing. Conditionally required for sellers in or shipping to the EU or Northern Ireland.
    Document[] documents?;
    # The EU-based Responsible Persons or entities for the listing. Maximum of 5; conditionally required for sellers in or shipping to the EU or Northern Ireland.
    ResponsiblePerson[] responsiblePersons?;
    # Hazardous material information for the listing. The statements field is required; pictograms, signalWord and component are optional.
    Hazmat hazmat?;
    # This type is used to define the pictograms and statement containers, and the optional component field, that provide product safety and compliance related information
    ProductSafety productSafety?;
    # This type provides name and contact information about the manufacturer of the item
    Manufacturer manufacturer?;
    # The manufacturer's repair score, from 0.0 (difficult to repair) to 10.0 (easily repaired), with at most one decimal place. Not applicable to all categories.
    decimal repairScore?;
};

# Enables a sales-tax table, sets a tax exception category code, or specifies a VAT percentage. Sales-tax tables are available only for the US and Canada marketplaces.
public type Tax record {
    # The VAT rate for the item, up to 6 characters with 3 decimal places (for example 12.345). Only for business sellers with a registered VAT-ID. Returned if set.
    decimal vatPercentage?;
    # Whether the seller's account-level sales-tax table is used to calculate sales tax. Must be true when thirdPartyTaxCategory is used. Returned if set.
    boolean applyTax?;
    # The tax exception category code, which applies sales tax to a service or fee as well as the item price. Requires applyTax set to true. Returned if set.
    string thirdPartyTaxCategory?;
};

# Represents the Queries record for the operation: getInventoryLocations
public type GetInventoryLocationsQueries record {
    # Number of locations to skip before returning the first location in the paginated response. Default: 0.
    string offset?;
    # Maximum number of records to return per page, as a positive integer (minimum 1). Up to 100 records are returned if not set.
    string 'limit?;
};

# Unit of measure for the weight of a shipping package.
public type WeightUnitOfMeasureEnum "POUND"|"KILOGRAM"|"OUNCE"|"GRAM";

# This type provides name and contact information about the manufacturer of the item
public type Manufacturer record {
    # Two-letter ISO 3166-1 Alpha-2 country codes.
    CountryCodeEnum country?;
    # The state or province of the product manufacturer's street address.
    # 
    # Maximum length: 64 characters
    string stateOrProvince?;
    # The city of the product manufacturer's street address.
    # 
    # Maximum length: 64 characters
    string city?;
    # The product manufacturer's business phone number.
    # 
    # Maximum length: 64 characters
    string phone?;
    # The company name of the product manufacturer.
    # 
    # Maximum length: 100 characters
    string companyName?;
    # The postal code of the product manufacturer's street address.
    # 
    # Maximum length: 9 characters
    string postalCode?;
    # The first line of the product manufacturer's street address.
    # 
    # Maximum length: 180 characters
    string addressLine1?;
    # The contact URL of the product manufacturer.
    # 
    # Maximum length: 250 characters
    string contactUrl?;
    # The second line of the manufacturer's street address, such as a suite or apartment number. Maximum length: 180 characters.
    string addressLine2?;
    # The product manufacturer's business email address.
    # 
    # Maximum length: 180 characters
    string email?;
};

# This type provides details of an offer, and is used by the base request payload of the createOffer and bulkCreateOffer methods
public type EbayOfferDetailsWithKeys record {
    # The quantity of the inventory item available for purchase on the marketplace; must be 1 or more to be purchasable. Overrides the inventory item quantity. Omit for auction listings.
    int:Signed32 availableQuantity?;
    # Set to true to create a private listing, which hides buyer IDs from other users.
    boolean hideBuyerDetails?;
    # Whether eBay product catalog details are applied to the listing, based on the product identifier. Defaults to true.
    boolean includeCatalogProductDetails;
    # The total number of items in a lot listing, whether identical or a mixed lot. Applies only to lot listings.
    int:Signed32 lotSize?;
    # The maximum quantity that each buyer may purchase, across one or more transactions. Set only if the seller restricts purchase quantity.
    int:Signed32 quantityLimitPerBuyer?;
    # Type defining regulatory information that the seller is required to disclose
    Regulatory regulatory?;
    # Listing format of the offer. Creating an auction offer reserves one unit of the item's available quantity until the auction ends.
    FormatTypeEnum format;
    # The unique identifier of a secondary category, used when listing the item in two categories. A fee may apply.
    string secondaryCategoryId?;
    # Enables a sales-tax table, sets a tax exception category code, or specifies a VAT percentage. Sales-tax tables are available only for the US and Canada marketplaces.
    Tax tax?;
    # Listing price and Minimum Advertised Price and Strikethrough Pricing settings. Price is required before an offer is published, but can be omitted when the offer is created.
    PricingSummary pricingSummary?;
    # Business policies (payment, return and fulfillment) and custom policies for the listing. Every published offer needs payment, return and fulfillment policies; also holds shipping cost overrides, eBay Plus and Best Offer settings.
    ListingPolicies listingPolicies?;
    # eBay marketplace sites.
    MarketplaceEnum marketplaceId;
    # Charitable organization associated with the listing and the percentage of sale proceeds it receives. The organization must be registered with the PayPal Giving Fund to receive proceeds.
    Charity charity?;
    # The unique identifier of the inventory location where the item is located. Not required when creating the offer, but required before it is published. Maximum length: 36.
    string merchantLocationKey?;
    # The full paths of up to two eBay store categories to place the item in, such as /Fashion/Men/Shirts.
    string[] storeCategoryNames?;
    # The future UTC date and time the listing becomes active, for example 2023-05-30T19:08:00Z. Optional; if omitted, the listing starts once published.
    string listingStartDate?;
    # IDs of the producer or importer related to the new item, packaging, added documentation or an eco-participation fee.
    ExtendedProducerResponsibility extendedProducerResponsibility?;
    # The seller-defined SKU of the product to list. Required. Only one offer may exist per SKU, marketplace and format combination. Maximum length: 50.
    string sku;
    # The unique identifier of the eBay category the product is listed under. Not required when creating the offer, but required before it is published.
    string categoryId?;
    # Listing duration periods. GTC applies to fixed-price listings and is their only supported duration; the DAYS_n values apply to auction listings.
    ListingDurationEnum listingDuration?;
    # The listing description; HTML is allowed. Required before the offer is published. Maximum length: 500,000, including HTML markup.
    string listingDescription?;
};

# This type is used by the base response payload for the getListingFees call.
public type FeesSummaryResponse record {
    # The listing fees the seller can expect to pay for the specified unpublished offers. Fees may be returned even when 0.0.
    FeeSummary[] feeSummaries;
};

# Type of shipping package used to ship an inventory item.
public type PackageTypeEnum "LETTER"|"BULKY_GOODS"|"CARAVAN"|"CARS"|"EUROPALLET"|"EXPANDABLE_TOUGH_BAGS"|"EXTRA_LARGE_PACK"|"FURNITURE"|"INDUSTRY_VEHICLES"|"LARGE_CANADA_POSTBOX"|"LARGE_CANADA_POST_BUBBLE_MAILER"|"LARGE_ENVELOPE"|"MAILING_BOX"|"MEDIUM_CANADA_POST_BOX"|"MEDIUM_CANADA_POST_BUBBLE_MAILER"|"MOTORBIKES"|"ONE_WAY_PALLET"|"PACKAGE_THICK_ENVELOPE"|"PADDED_BAGS"|"PARCEL_OR_PADDED_ENVELOPE"|"ROLL"|"SMALL_CANADA_POST_BOX"|"SMALL_CANADA_POST_BUBBLE_MAILER"|"TOUGH_BAGS"|"UPS_LETTER"|"USPS_FLAT_RATE_ENVELOPE"|"USPS_LARGE_PACK"|"VERY_LARGE_PACK"|"WINE_PAK";

# Represents the Headers record for the operation: bulkGetInventoryItem
public type BulkGetInventoryItemHeaders record {
    # This header indicates the format of the request body provided by the client. Its value should be set to application/json
    @http:Header {name: "Content-Type"}
    string contentType;
};

# Type of EU Responsible Person associated with a listing.
public type ResponsiblePersonTypeEnum "EU_RESPONSIBLE_PERSON";

# This type is used to specify the quantity of the inventory item that is available for purchase if the item will be shipped to the buyer
public type Availability record {
    # This type is used to specify the total 'ship-to-home' quantity of the inventory item that will be available for purchase through one or more published offers
    ShipToLocationAvailability shipToLocationAvailability?;
};

# Possible states of an inventory location.
public type StatusEnum "DISABLED"|"ENABLED";

# This type provides an array of locations that are associated with a SKU within a listing
public type LocationMapping record {
    # The fulfillment center locations mapped to the SKU. Only the first 50 locations are used to calculate estimated delivery dates.
    LocationAvailabilityDetails[] locations;
};

# Represents the Headers record for the operation: withdrawOfferByInventoryItemGroup
public type WithdrawOfferByInventoryItemGroupHeaders record {
    # This header indicates the format of the request body provided by the client. Its value should be set to application/json
    @http:Header {name: "Content-Type"}
    string contentType;
};

# This type is used by the response payload of the bulkMigrateListings call
public type BulkMigrateListingResponse record {
    # This is the base container of the response payload of the bulkMigrateListings call. The results of each attempted listing migration is captured under this container
    MigrateListingResponse[] responses;
};

# Represents the Headers record for the operation: getListingFees
public type GetListingFeesHeaders record {
    # This header indicates the format of the request body provided by the client. Its value should be set to application/json
    @http:Header {name: "Content-Type"}
    string contentType;
};

# Current status of the offer, published or unpublished.
public type OfferStatusEnum "PUBLISHED"|"UNPUBLISHED";

# Weight of a shipping package and its unit of measure. Conditionally required for calculated shipping rates or flat-rate shipping with a weight surcharge.
public type Weight record {
    # Unit of measure for the weight of a shipping package.
    WeightUnitOfMeasureEnum unit?;
    # The weight of the shipping package in the unit given by the unit field. Both unit and value are required.
    decimal value?;
};

# This type is used by the offers container in a Bulk Update Price and Quantity call to update the current price and/or quantity of one or more offers associated with a specific inventory item
public type OfferPriceQuantity record {
    # The quantity of the item available in the offer's marketplace; should not exceed the total ship-to-home quantity. Either this or price is required.
    int:Signed32 availableQuantity?;
    # This type is used to express a dollar value and the applicable currency
    Amount price?;
    # The unique identifier of the offer to update with a new price and/or quantity. Required when updating offers.
    string offerId?;
};

# This type is used by the base response of the bulkPublishOffer method
public type BulkPublishResponse record {
    # A node is returned under the responses container to indicate the success or failure of each offer that the seller was attempting to publish
    OfferResponseWithListingId[] responses;
};

# Listing price and Minimum Advertised Price and Strikethrough Pricing settings. Price is required before an offer is published, but can be omitted when the offer is created.
public type PricingSummary record {
    # Controls how and when the Minimum Advertised Price is shown for an offer. Available only on the US site.
    MinimumAdvertisedPriceHandlingEnum pricingVisibility?;
    # This type is used to express a dollar value and the applicable currency
    Amount auctionReservePrice?;
    # This type is used to express a dollar value and the applicable currency
    Amount price?;
    # This type is used to express a dollar value and the applicable currency
    Amount minimumAdvertisedPrice?;
    # This type is used to express a dollar value and the applicable currency
    Amount auctionStartPrice?;
    # Where the product was sold for the originalRetailPrice: on eBay, off eBay, or both. Applies only to listings eligible for Strikethrough Pricing.
    SoldOnEnum originallySoldForRetailPriceOn?;
    # This type is used to express a dollar value and the applicable currency
    Amount originalRetailPrice?;
};

# Represents the Headers record for the operation: createInventoryLocation
public type CreateInventoryLocationHeaders record {
    # This header indicates the format of the request body provided by the client. Its value should be set to application/json
    @http:Header {name: "Content-Type"}
    string contentType;
};

# SKU and offer ID pair returned in the inventoryItems container of the bulkMigrateListing response. Up to five pairs may be returned per listing.
public type InventoryItemListing record {
    # The eBay-generated unique identifier of the offer created by the listing migration. Returned only if the migration succeeds.
    string offerId?;
    # The seller-defined SKU of the item in the listing, used to manage the inventory item after migration. Returned even if the migration fails.
    string sku;
};

# Two-letter ISO 3166-1 Alpha-2 country codes.
public type CountryCodeEnum "AD"|"AE"|"AF"|"AG"|"AI"|"AL"|"AM"|"AN"|"AO"|"AQ"|"AR"|"AS"|"AT"|"AU"|"AW"|"AX"|"AZ"|"BA"|"BB"|"BD"|"BE"|"BF"|"BG"|"BH"|"BI"|"BJ"|"BL"|"BM"|"BN"|"BO"|"BQ"|"BR"|"BS"|"BT"|"BV"|"BW"|"BY"|"BZ"|"CA"|"CC"|"CD"|"CF"|"CG"|"CH"|"CI"|"CK"|"CL"|"CM"|"CN"|"CO"|"CR"|"CU"|"CV"|"CW"|"CX"|"CY"|"CZ"|"DE"|"DJ"|"DK"|"DM"|"DO"|"DZ"|"EC"|"EE"|"EG"|"EH"|"ER"|"ES"|"ET"|"FI"|"FJ"|"FK"|"FM"|"FO"|"FR"|"GA"|"GB"|"GD"|"GE"|"GF"|"GG"|"GH"|"GI"|"GL"|"GM"|"GN"|"GP"|"GQ"|"GR"|"GS"|"GT"|"GU"|"GW"|"GY"|"HK"|"HM"|"HN"|"HR"|"HT"|"HU"|"ID"|"IE"|"IL"|"IM"|"IN"|"IO"|"IQ"|"IR"|"IS"|"IT"|"JE"|"JM"|"JO"|"JP"|"KE"|"KG"|"KH"|"KI"|"KM"|"KN"|"KP"|"KR"|"KW"|"KY"|"KZ"|"LA"|"LB"|"LC"|"LI"|"LK"|"LR"|"LS"|"LT"|"LU"|"LV"|"LY"|"MA"|"MC"|"MD"|"ME"|"MF"|"MG"|"MH"|"MK"|"ML"|"MM"|"MN"|"MO"|"MP"|"MQ"|"MR"|"MS"|"MT"|"MU"|"MV"|"MW"|"MX"|"MY"|"MZ"|"NA"|"NC"|"NE"|"NF"|"NG"|"NI"|"NL"|"NO"|"NP"|"NR"|"NU"|"NZ"|"OM"|"PA"|"PE"|"PF"|"PG"|"PH"|"PK"|"PL"|"PM"|"PN"|"PR"|"PS"|"PT"|"PW"|"PY"|"QA"|"RE"|"RO"|"RS"|"RU"|"RW"|"SA"|"SB"|"SC"|"SD"|"SE"|"SG"|"SH"|"SI"|"SJ"|"SK"|"SL"|"SM"|"SN"|"SO"|"SR"|"ST"|"SV"|"SX"|"SY"|"SZ"|"TC"|"TD"|"TF"|"TG"|"TH"|"TJ"|"TK"|"TL"|"TM"|"TN"|"TO"|"TR"|"TT"|"TV"|"TW"|"TZ"|"UA"|"UG"|"UM"|"US"|"UY"|"UZ"|"VA"|"VC"|"VE"|"VG"|"VI"|"VN"|"VU"|"WF"|"WS"|"YE"|"YT"|"ZA"|"ZM"|"ZW";

# This type is used to provide details of a single inventory item
public type InventoryItemWithSkuLocaleGroupid record {
    # Condition of the inventory item. Each value maps to an eBay condition ID, and valid conditions vary by category.
    ConditionEnum condition?;
    # Product details such as title, description, aspects and image links. Can include an ePID or GTIN (EAN, ISBN or UPC) to match a product in the eBay Catalog.
    Product product?;
    # Structured name-value pairs that describe the item's condition, required for graded or ungraded trading cards and coins.
    ConditionDescriptor[] conditionDescriptors?;
    # The unique identifiers of the inventory item groups the item belongs to. Returned only if the item is in at least one group.
    string[] groupIds?;
    # Package type, weight and dimensions of the shipping package. Weight and dimensions are required for calculated shipping; weight alone is required for flat-rate shipping with a weight surcharge.
    PackageWeightAndSize packageWeightAndSize?;
    # This type is used to specify the quantity of the inventory items that are available for purchase if the items will be shipped to the buyer
    AvailabilityWithAll availability?;
    # Locale that indicates the language used to express the inventory item details.
    LocaleEnum locale;
    # The seller-defined Stock-Keeping Unit (SKU) of the inventory item. The seller should have a unique SKU value for every product that they sell
    string sku?;
    # A description of a used item's condition; ignored for items in a new condition. Maximum length: 1000.
    string conditionDescription?;
    # The unique identifiers of the item's variations in multiple-variation listings. Returned only if the item is in at least one inventory item group.
    string[] inventoryItemGroupKeys?;
};

# Identifies a motor vehicle compatible with the inventory item, by eBay Product ID or K-Type value. The gtin field is for future use only.
public type ProductIdentifier record {
    # The Global Trade Item Number of the compatible motor vehicle. Reserved for future use.
    string gtin?;
    # The eBay catalog product ID (ePID) of the compatible motor vehicle; if found, its properties are filled in automatically.
    string epid?;
    # The K Type Number of the compatible motor vehicle; if found, its properties are filled in automatically. Supported only on the AU, DE, ES, FR, IT and UK marketplaces.
    string ktype?;
};

# This type defines the override dates for cut-off times. This allows sellers to set special hours for their inventory location and specify different cut-off times on these days
public type Overrides record {
    # The end date of the cut-off time override in ISO 8601 format (YYYY-MM-DD). Use the same date as startDate for a single day.
    string endDate?;
    # The start date of the cut-off time override in ISO 8601 format (YYYY-MM-DD). Use the same date as endDate for a single day.
    string startDate?;
    # The cut-off time that overrides the weekly schedule for the date range; orders after it are handled the next day. Format: 00:00.
    string cutOffTime?;
};

# This type is used by the base response of the bulkCreateOffer method
public type BulkOfferResponse record {
    # This object contains the responses that show the status of each offer that the seller attempted to create with the method call
    OfferSkuResponse[] responses;
};

# This type is used to provide detailed information about an inventory item
public type InventoryItem record {
    # Condition of the inventory item. Each value maps to an eBay condition ID, and valid conditions vary by category.
    ConditionEnum condition?;
    # Product details such as title, description, aspects and image links. Can include an ePID or GTIN (EAN, ISBN or UPC) to match a product in the eBay Catalog.
    Product product?;
    # Structured name-value pairs that describe the item's condition, required for graded or ungraded trading cards and coins.
    ConditionDescriptor[] conditionDescriptors?;
    # Package type, weight and dimensions of the shipping package. Weight and dimensions are required for calculated shipping; weight alone is required for flat-rate shipping with a weight surcharge.
    PackageWeightAndSize packageWeightAndSize?;
    # This type is used to specify the quantity of the inventory item that is available for purchase if the item will be shipped to the buyer
    Availability availability?;
    # A description of a used item's condition; ignored for new conditions. Required when updating an item that already has one. Returned if set. Maximum length: 1000.
    string conditionDescription?;
};

# This type is used by the base response of the bulkCreateOrReplaceInventoryItem method
public type BulkInventoryItemResponse record {
    # This is the base container of the bulkCreateOrReplaceInventoryItem response. The results of each attempted inventory item creation/update is captured under this container
    InventoryItemResponse[] responses;
};

# Response of the createOffer and updateOffer calls with any errors or warnings. The offerId is returned only by a successful createOffer call.
public type OfferResponse record {
    # This container will contain an array of errors and/or warnings when a call is made, and errors and/or warnings occur
    ErrorDetailV3[] warnings?;
    # The unique identifier of the offer created by createOffer. Returned only on success and not returned by updateOffer.
    string offerId?;
};

# The seller-defined Stock-Keeping Unit (SKU) of each inventory item that the user wants to retrieve is passed in the request of the bulkGetInventoryItem method
public type GetInventoryItem record {
    # An array of SKU values are passed in under the sku container to retrieve up to 25 inventory item records.
    # 
    # Use the getInventoryItems method to retrieve SKU values
    string sku;
};

# This type is used by the base response payload for the getInventoryLocations call
public type LocationResponse record {
    # The URI for the following page of results. This value is returned only if there is an additional page of results to display from the result set.
    # 
    # Maximum length: 2048
    string next?;
    # The total number of items retrieved in the result set.
    # 
    # If no items are found, this field is returned with a value of 0
    int:Signed32 total?;
    # The number of results skipped before the first returned result, as set by the offset query parameter. The list is zero-based.
    int:Signed32 offset?;
    # The URI for the preceding page of results. This value is returned only if there is a previous page of results to display from the result set.
    # 
    # Maximum length: 2048
    string prev?;
    # The number of items returned on a single page from the result set
    int:Signed32 'limit?;
    # An array of one or more of the merchant's inventory locations
    InventoryLocationResponse[] locations?;
    # The URI of the current page of results from the result set
    string href?;
};

# Represents the Headers record for the operation: publishOfferByInventoryItemGroup
public type PublishOfferByInventoryItemGroupHeaders record {
    # This header indicates the format of the request body provided by the client. Its value should be set to application/json
    @http:Header {name: "Content-Type"}
    string contentType;
};

# Represents the Headers record for the operation: bulkCreateOffer
public type BulkCreateOfferHeaders record {
    # This header sets the natural language that will be used in the field values of the request payload. For example, the value passed in this header should be en-US for English or de-DE for German
    @http:Header {name: "Content-Language"}
    string contentLanguage;
    # This header indicates the format of the request body provided by the client. Its value should be set to application/json
    @http:Header {name: "Content-Type"}
    string contentType;
};

# Represents the Headers record for the operation: bulkCreateOrReplaceInventoryItem
public type BulkCreateOrReplaceInventoryItemHeaders record {
    # This header sets the natural language that will be used in the field values of the request payload. For example, the value passed in this header should be en-US for English or de-DE for German
    @http:Header {name: "Content-Language"}
    string contentLanguage;
    # This header indicates the format of the request body provided by the client. Its value should be set to application/json
    @http:Header {name: "Content-Type"}
    string contentType;
};

# Listing format of the offer. Creating an auction offer reserves one unit of the item's available quantity until the auction ends.
public type FormatTypeEnum "AUCTION"|"FIXED_PRICE";

# OAuth2 Refresh Token Grant Configs
public type OAuth2RefreshTokenGrantConfig record {|
    *http:OAuth2RefreshTokenGrantConfig;
    # Refresh URL
    string refreshUrl = "https://api.ebay.com/identity/v1/oauth2/token";
|};

# This type is used to indicate the fulfillment time for an order that will be shipped to the buyer
public type TimeDuration record {
    # Time unit used by the TimeDuration type, typically BUSINESS_DAY for order fulfillment time.
    TimeDurationUnitEnum unit?;
    # The fulfillment time, in the unit given by the unit field.
    int:Signed32 value?;
};

# This type is used by the bestOfferTerms container, which is used if the seller would like to support the Best Offer feature on their listing
public type BestOffer record {
    # Whether the Best Offer feature is enabled for the listing; set to true to enable it. Not available for multi-variation listings.
    boolean bestOfferEnabled?;
    # This type is used to express a dollar value and the applicable currency
    Amount autoAcceptPrice?;
    # This type is used to express a dollar value and the applicable currency
    Amount autoDeclinePrice?;
};

# Request payload of bulkUpdatePriceQuantity, which updates the total ship-to-home quantity of up to 25 inventory items and/or the price and quantity of specific published offers.
public type BulkPriceQuantity record {
    # The inventory items (up to 25) whose ship-to-home quantity to update, and/or the published offers whose price or quantity to update.
    PriceQuantity[] requests;
};

# This type is used by the base request of the WithdrawByInventoryItemGroup method, which is used to end a multiple-variation listing
public type WithdrawByInventoryItemGroupRequest record {
    # eBay marketplace sites.
    MarketplaceEnum marketplaceId;
    # The eBay-generated unique identifier of the inventory item group.
    string inventoryItemGroupKey;
};

# Represents the Headers record for the operation: createOrReplaceProductCompatibility
public type CreateOrReplaceProductCompatibilityHeaders record {
    # This header sets the natural language that will be used in the field values of the request payload. For example, the value passed in this header should be en-US for English or de-DE for German
    @http:Header {name: "Content-Language"}
    string contentLanguage;
    # This header indicates the format of the request body provided by the client. Its value should be set to application/json
    @http:Header {name: "Content-Type"}
    string contentType;
};

# This type is used by the response of the bulkGetInventoryItem method to give the status of each inventory item record that the user tried to retrieve
public type GetInventoryItemResponse record {
    # This type is used to provide details about each retrieved inventory item record
    InventoryItemWithSkuLocaleGroupKeys inventoryItem;
    # This container will be returned if there were one or more warnings associated with retrieving the inventory item record
    ErrorDetailV3[] warnings?;
    # The seller-defined Stock-Keeping Unit (SKU) of the inventory item. The seller should have a unique SKU value for every product that they sell
    string sku;
    # This container will be returned if there were one or more errors associated with retrieving the inventory item record
    ErrorDetailV3[] errors?;
    # The HTTP status code indicating whether the inventory item for the given SKU was retrieved successfully.
    int:Signed32 statusCode;
};

# This type lists regional take-back policies to be used by an offer when it is published and converted to a listing
public type RegionalTakeBackPolicies record {
    # The array of country-specific take-back policies to be used by an offer when it is published and converted to a listing
    CountryPolicy[] countryPolicies?;
};

# This type is used to specify/indicate the motor vehicles that are compatible with the corresponding inventory item. 
public type CompatibleProduct record {
    # Seller notes about the compatible vehicle, such as the part's placement on the vehicle. Returned only if set. Maximum length: 500.
    string notes?;
    # Identifies a motor vehicle compatible with the inventory item, by eBay Product ID or K-Type value. The gtin field is for future use only.
    ProductIdentifier productIdentifier?;
    # The vehicle aspect name-value pairs (such as make, model, year, trim and engine) that identify a compatible motor vehicle. Make, model and year are typically required.
    NameValueList[] compatibilityProperties?;
    # This type is used to specify the details of a motor vehicle that is compatible with the inventory item specified through the SKU value in the call URI
    ProductFamilyProperties productFamilyProperties?;
};

# Status of each offer the seller attempted to create with bulkCreateOffer. A successful offer has statusCode 200 and a new offerId; otherwise errors and/or warnings are returned.
public type OfferSkuResponse record {
    # eBay marketplace sites.
    MarketplaceEnum marketplaceId;
    # Warnings raised while creating the offer. An offer can still be created successfully with warnings.
    ErrorDetailV3[] warnings?;
    # Listing format of the offer. Creating an auction offer reserves one unit of the item's available quantity until the auction ends.
    FormatTypeEnum format;
    # The unique identifier of the newly created offer. Not returned if the offer could not be created.
    string offerId?;
    # The seller-defined SKU of the inventory item. Required for each offer and always returned.
    string sku;
    # This container will be returned at the offer level, and will contain one or more errors if any occurred with the attempted creation of the corresponding offer
    ErrorDetailV3[] errors?;
    # The HTTP status code of the offer creation attempt; 200 indicates success.
    int:Signed32 statusCode;
};

# This type is used by the createInventoryLocation call to specify cut-off time(s) for an inventory location, as well as any overrides for these times
public type SameDayShippingCutOffTimes record {
    # The weekly schedule of shipping cut-off times, required for each business day; orders after the cut-off are handled the next day.
    WeeklySchedule[] weeklySchedule?;
    # This container can be used to override the existing cut-off time(s), specified in the weeklySchedule container, for a specific date or date range
    Overrides[] overrides?;
};

# Result of creating or updating one inventory item record with bulkCreateOrReplaceInventoryItem, identified by its SKU.
public type InventoryItemResponse record {
    # This container will be returned if there were one or more warnings associated with the creation or update to the inventory item record
    ErrorDetailV3[] warnings?;
    # Locale that indicates the language used to express the inventory item details.
    LocaleEnum locale;
    # The seller-defined Stock-Keeping Unit (SKU) of the inventory item. The seller should have a unique SKU value for every product that they sell
    string sku;
    # This container will be returned if there were one or more errors associated with the creation or update to the inventory item record
    ErrorDetailV3[] errors?;
    # The HTTP status code indicating whether the inventory item for the given SKU was created or updated successfully.
    int:Signed32 statusCode;
};

# This type is used by the base response payload of getInventoryItems call.
public type InventoryItems record {
    # This is the URL to the next page of inventory items. This field will only be returned if there are additional inventory items to view
    string next?;
    # The total number of inventory items in the seller's account, used with the limit value to page through results.
    int:Signed32 total;
    # This container is an array of one or more inventory items, with detailed information on each inventory item
    InventoryItemWithSkuLocaleGroupid[] inventoryItems;
    # This integer value indicates the total number of pages of results that are available. This number will depend on the total number of inventory items available for viewing, and on the limit value
    int:Signed32 size;
    # This is the URL to the previous page of inventory items. This field will only be returned if there are previous inventory items to view
    string prev?;
    # This integer value is the number of inventory items that will be displayed on each results page
    int:Signed32 'limit;
    # This is the URL to the current page of inventory items
    string href;
};

# Represents the Headers record for the operation: createOrReplaceSkuLocationMapping
public type CreateOrReplaceSkuLocationMappingHeaders record {
    # This header indicates the format of the request body provided by the client. Its value should be set to application/json
    @http:Header {name: "Content-Type"}
    string contentType;
};

# Where the product was sold for the originalRetailPrice: on eBay, off eBay, or both. Applies only to listings eligible for Strikethrough Pricing.
public type SoldOnEnum "ON_EBAY"|"OFF_EBAY"|"ON_AND_OFF_EBAY";

# Represents the Queries record for the operation: getInventoryItems
public type GetInventoryItemsQueries record {
    # Page number to retrieve, starting at 0 for the first page. Default: 0.
    string offset?;
    # Maximum number of records to return per page, as an integer from 1 to 200. Default: 25.
    string 'limit?;
};

# This type is used by the base request payload of the getListingFees call
public type OfferKeysWithId record {
    # The unpublished offers (up to 250) to retrieve expected listing fees for. Fees are returned per marketplace, not per offer.
    OfferKeyWithId[] offers;
};

# Condition of the inventory item. Each value maps to an eBay condition ID, and valid conditions vary by category.
public type ConditionEnum "NEW"|"LIKE_NEW"|"NEW_OTHER"|"NEW_WITH_DEFECTS"|"MANUFACTURER_REFURBISHED"|"CERTIFIED_REFURBISHED"|"EXCELLENT_REFURBISHED"|"VERY_GOOD_REFURBISHED"|"GOOD_REFURBISHED"|"SELLER_REFURBISHED"|"USED_EXCELLENT"|"USED_VERY_GOOD"|"USED_GOOD"|"USED_ACCEPTABLE"|"FOR_PARTS_OR_NOT_WORKING"|"PRE_OWNED_EXCELLENT"|"PRE_OWNED_FAIR";

# This type is used to specify the total 'ship-to-home' quantity of the inventory item that will be available for purchase through one or more published offers
public type ShipToLocationAvailability record {
    # The total ship-to-home quantity available across all marketplaces. Must be set before an offer can be published; resend it on updates or it is lost.
    int:Signed32 quantity?;
    # The available quantity of the inventory item at one or more warehouse locations. Returned if set.
    AvailabilityDistribution[] availabilityDistributions?;
};

# Represents the Headers record for the operation: bulkUpdatePriceQuantity
public type BulkUpdatePriceQuantityHeaders record {
    # This header indicates the format of the request body provided by the client. Its value should be set to application/json
    @http:Header {name: "Content-Type"}
    string contentType;
};

# This type is used to specify one to five eBay listings that will be migrated to the new Inventory model
public type MigrateListing record {
    # The unique identifier of the eBay listing to migrate to the Inventory model. Up to five listings can be specified.
    string listingId;
};

# This type is used by the updateInventoryLocation call to update operating hours, special hours, phone number, and other minor details of an inventory location
public type InventoryLocation record {
    # This container is used to update the location type(s) associated with an inventory location
    StoreTypeEnum[] locationTypes?;
    # The phone number of the inventory location; replaces any existing phone number. Maximum length: 36.
    string phone?;
    # The time zone of the inventory location in Olson format (for example America/Vancouver). Used for all hour-related fields; if omitted, it is derived from the address.
    string timeZoneId?;
    # The website URL of the inventory location; replaces any existing URL. Maximum length: 512.
    string locationWebUrl?;
    # A human-friendly name for the inventory location; replaces any existing name. Not required for warehouse locations.
    string name?;
    # This type is used by the createInventoryLocation call to provide an full or partial address of an inventory location
    LocationDetails location?;
    # This type is used to provide shipping specification details, such as the weekly cut-off schedule for order handling and cut-off override(s), for a fulfillment center location. 
    FulfillmentCenterSpecifications fulfillmentCenterSpecifications?;
    # Additional information about the inventory location; replaces the current value, so resend it unchanged if not updating. Maximum length: 256.
    string locationAdditionalInformation?;
};

# This type is used to provide details about each retrieved inventory item record
public type InventoryItemWithSkuLocaleGroupKeys record {
    # Condition of the inventory item. Each value maps to an eBay condition ID, and valid conditions vary by category.
    ConditionEnum condition?;
    # Product details such as title, description, aspects and image links. Can include an ePID or GTIN (EAN, ISBN or UPC) to match a product in the eBay Catalog.
    Product product?;
    # Structured name-value pairs that describe the item's condition, required for graded or ungraded trading cards and coins.
    ConditionDescriptor[] conditionDescriptors?;
    # Package type, weight and dimensions of the shipping package. Weight and dimensions are required for calculated shipping; weight alone is required for flat-rate shipping with a weight surcharge.
    PackageWeightAndSize packageWeightAndSize?;
    # This type is used to specify the quantity of the inventory items that are available for purchase if the items will be shipped to the buyer
    AvailabilityWithAll availability?;
    # Locale that indicates the language used to express the inventory item details.
    LocaleEnum locale;
    # The seller-defined Stock-Keeping Unit (SKU) of the inventory item. The seller should have a unique SKU value for every product that they sell
    string sku?;
    # A description of a used item's condition; ignored for items in a new condition. Maximum length: 1000.
    string conditionDescription?;
    # The identifiers of the inventory item groups the item belongs to. Returned only if the item is in a group.
    string[] inventoryItemGroupKeys?;
};

# A complex type that is used to provide the physical address of a location, and it geo-coordinates
public type Location record {
    # This type is used to define the physical address of an inventory location
    Address address;
    # The eBay-assigned ID of the location, used only internally by eBay. Not the same as the seller-defined merchantLocationKey.
    string locationId;
    # This type is used to express the Global Positioning System (GPS) latitude and longitude coordinates of an inventory location
    GeoCoordinates geoCoordinates?;
};
